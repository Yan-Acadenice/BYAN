{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // See tsconfig.main.json for rationale — both tsconfigs share the
    // shared/ipc-contract.ts file as the single source of truth for IPC types.
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noEmit": false
  },
  "include": ["preload/**/*.ts", "shared/**/*.ts"]
}

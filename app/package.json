{
  "name": "byan-app",
  "private": true,
  "version": "1.4.0",
  "description": "BYAN Electron desktop app — main + preload + renderer (TypeScript). F1 app shell, F2 IPC contract.",
  "_comment_workspace": "Standalone package.json (NOT an npm workspace). Root /home/yan/BYAN/package.json already publishes create-byan-agent and depends on file:./install/packages/platform-config; activating workspaces would conflict with that publishing flow. app/ owns its own deps and lockfile.",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js --format=cjs --sourcemap",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer",
    "watch:main": "tsc -p tsconfig.main.json -w --preserveWatchOutput",
    "watch:preload": "esbuild preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js --format=cjs --sourcemap --watch",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && wait-on dist/main/index.js dist/preload/index.js && cross-env BYAN_DEV=1 electron .",
    "dev": "npm run build:main && npm run build:preload && concurrently -k -n renderer,main,preload,electron -c blue,green,yellow,magenta \"npm:dev:renderer\" \"npm:watch:main\" \"npm:watch:preload\" \"npm:dev:electron\"",
    "start": "electron .",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload && npm run typecheck:renderer && npm run typecheck:e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env BYAN_API_LIVE=1 vitest run main/__tests__/integration/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "test:e2e:list": "playwright test --list",
    "lint": "eslint .",
    "build:app": "npm run build && electron-builder --linux --win --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "byan-platform-config": "file:../install/packages/platform-config",
    "chalk": "^4.1.2",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.6",
    "inquirer": "^8.2.7",
    "js-yaml": "^4.3.0",
    "keytar": "^7.9.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.13",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "homepage": "https://github.com/Yan-Acadenice/BYAN",
  "author": "Yan Acadenice <yan@acadenice.fr>"
}

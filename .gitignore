# Git Ignore - BYAN Project Root

# Node modules
node_modules/
install/node_modules/
app/node_modules/

# Electron app build output
app/dist/
app/release/
app/playwright-report/
app/test-results/

# Design source (Stitch generated reference, not source code)
_design/
stitch_design_system_implementation.zip

# NPM artifacts
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
# Exception: app/package-lock.json is required by the CI workflow's `npm ci`
# step (reproducible installs). The repo root lockfile stays ignored to avoid
# coupling the create-byan-agent publishing flow with app/ deps.
!app/package-lock.json

# Client-specific agents (not tracked in git)
.github/agents/franck.md
.github/agents/expert-merise-agile.md
_bmad/bmm/agents/expert-merise-agile.md
_bmad-output/bmb-creations/franck/
_bmad-output/agent-spec-expert-merise-agile.yaml
_bmad-output/bmb-creations/expert-merise-agile*.md
_bmad-output/interview-summary-*-franck-*.md
_bmad-output/interview-summary-*-expert-merise-*.md

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
.cache/

# Build outputs
dist/
build/
out/

# Exception: app/build/ holds electron-builder resources (icons, entitlements)
# that must be tracked — only the root-level build/ output dir is ephemeral.
!app/build/
!app/build/**

# Environment
.env
.env.local
.env.*.local

# Claude Code local config — peut contenir des secrets (API tokens), hors versionnement
.claude/settings.local.json

# Codex auto-delegate opt-in — reglage par-machine (arme le conseil de delegation
# vers Codex). Ecrit a l'opt-in / a la main ; jamais committe, sinon il armerait
# la feature pour tous les utilisateurs. L'etat shippe est "absent = desarme".
_byan/_config/autodelegate.json

# Logs
logs/
*.log

# Test coverage
coverage/
.nyc_output/

# Documentation artifacts (transient)
install/MARC-VALIDATION-*.md
install/*-TEST-*.md
install/README-PUBLICATION-*.md
install/create-byan-agent-*.tgz

# Backup files
*.backup.*
*.bak

# BYAN API (local only, never committed)
api/

# BYAN transparency logs + session-local state
_byan-output/
# Legacy BMAD-era generated output (superseded by _byan-output/); untracked 2026-06-23
_bmad-output/
# Copilot session-resume IDs (personal, local only)
.resume
# Mid-session soul-memory nudge one-shot marker (per-session, never committed;
# reset at SessionStart). Un-rooted glob so it also covers the install/templates
# mirror and any future memory-dir layout, not just the canonical repo copy.
**/.soul-memory-nudge-sent

# BYAN Strict Mode runtime state (per-session, never committed)
.byan-strict/

# BYAN Auto-Benchmark runtime state (arm/escape flags, block-once tokens)
.byan-autobench/

# BYAN Leantime auto-sync sidecar (per-fd id map + sync log, never committed)
.byan-leantime/

# BYAN tier gate sidecar (deny-once memory + off switch, never committed)
.byan-tier/

# BYAN runtime memoire state — mutated at runtime by EloStore / KnowledgeGraph,
# so it generated constant git noise. Root-only paths (the separators anchor them
# to repo root); the template keeps its own seed copies under install/templates/.
_byan/memoire/elo-profile.json
_byan/memoire/fact-graph.json

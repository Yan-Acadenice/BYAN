{
  "name": "create-byan-agent",
  "version": "2.47.1",
  "description": "BYAN v2.8 - Intelligent AI agent creator with ELO trust system + scientific fact-check + Hermes universal dispatcher + native Claude Code integration (hooks, skills, MCP server). Multi-platform (Claude Code, Codex). Merise Agile + TDD + 71 Mantras. ~54% LLM cost savings.",
  "main": "src/index.js",
  "bin": {
    "create-byan-agent": "./install/bin/create-byan-agent-v2.js",
    "byan-v2": "./install/bin/create-byan-agent-v2.js",
    "byan-cleanup": "./install/bin/byan-cleanup.js",
    "byan-handoff": "./install/bin/byan-handoff.js",
    "byan-ledger": "./install/bin/byan-ledger.js",
    "byan-kanban": "./install/bin/byan-kanban.js",
    "update-byan-agent": "./update-byan-agent/bin/update-byan-agent.js"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest install/__tests__/post-install.e2e.test.js",
    "setup-turbo-whisper": "node install/setup-turbo-whisper.js",
    "setup-rtk": "node install/setup-rtk.js",
    "setup-gdoc": "node install/setup-gdoc.js",
    "byan": "echo \"BYAN agent installed. Open Claude Code (or Codex) in this project.\"",
    "version": "node scripts/sync-install-version.js && git add install/package.json",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:typecheck": "npm --prefix app run typecheck",
    "app:install": "npm --prefix app install"
  },
  "keywords": [
    "byan",
    "ai",
    "multi-agent",
    "workflow",
    "agent-builder",
    "bmad",
    "merise-agile",
    "tdd",
    "voice-dictation",
    "whisper",
    "turbo-whisper"
  ],
  "author": "Yan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yan-Acadenice/BYAN.git"
  },
  "bugs": {
    "url": "https://github.com/Yan-Acadenice/BYAN/issues"
  },
  "homepage": "https://github.com/Yan-Acadenice/BYAN#readme",
  "engines": {
    "node": ">=12.0.0"
  },
  "files": [
    "src/",
    "install/bin/",
    "install/lib/",
    "install/templates/",
    "install/src/",
    "install/packages/platform-config/index.js",
    "install/packages/platform-config/lib/",
    "install/packages/platform-config/package.json",
    "install/setup-turbo-whisper.js",
    "install/setup-parakeet.js",
    "install/setup-rtk.js",
    "install/setup-gdoc.js",
    "install/install.sh",
    "install/package.json",
    "update-byan-agent/bin/",
    "update-byan-agent/lib/",
    "update-byan-agent/package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.114",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "byan-platform-config": "file:./install/packages/platform-config",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.5",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "bundleDependencies": [
    "byan-platform-config"
  ],
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/api/",
      "fs-migration-hook\\.test\\.js",
      "e2e-remote-import\\.test\\.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
